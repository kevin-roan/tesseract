# TheOne sandbox stack configuration.
# Copy to infra/compose/.env (git-ignored) and adjust, or point infra/scripts/sandbox at
# another file with --env-file <path> (only that file is read then). docker compose reads
# it for variable interpolation only: a container receives just the variables its compose
# file lists, so TS_AUTHKEY never reaches the sandbox and THEONE_TOKEN never reaches the
# tailscale sidecar. Empty values count as unset; exported shell variables win over
# the file.

# ---------------------------------------------------------------------------
# Mode (infra/scripts/sandbox): tailscale | host-tailscale | local
#   tailscale       userspace tailscale sidecar, nothing published on the host (default)
#   host-tailscale  ports bound on the host's existing tailscale IPv4
#   local           ports bound on 127.0.0.1 (development, e2e tests)
# THEONE_DIND=1 adds the privileged docker:dind sidecar (same as --dind).
# THEONE_TAILSCALE_LOCALAPI=1 shares the tailscaled LocalAPI socket with the sandbox (same
# as --tailscale-api) so the app's Profile tab shows the real Tailscale user and node:
# the sidecar's socket in tailscale mode, the host's socket directory
# (THEONE_TAILSCALE_HOST_SOCKET_DIR, default /var/run/tailscale) otherwise. Root inside the
# sandbox (dev has sudo) can then reconfigure that tailscaled; in host-tailscale/local mode
# that is the HOST's Tailscale. See docs/architecture/security-model.md before enabling.
# ---------------------------------------------------------------------------
THEONE_MODE=tailscale
THEONE_DIND=
THEONE_TAILSCALE_LOCALAPI=
THEONE_TAILSCALE_HOST_SOCKET_DIR=

# ---------------------------------------------------------------------------
# Stack identity: change these to run another stack next to the default one (tests,
# a second sandbox). Stacks with different names never share containers or volumes; a
# second stack also needs its own host ports (local) or THEONE_HOSTNAME (tailscale).
# ---------------------------------------------------------------------------
# Compose project name (lowercase letters, digits, '-' and '_'); prefixes container and
# network names.
THEONE_COMPOSE_PROJECT=theone
# Prefix of the named volumes: <prefix>-workspace, <prefix>-home, <prefix>-tailscale,
# <prefix>-dind-certs, <prefix>-dind-data. Empty = THEONE_COMPOSE_PROJECT.
THEONE_VOLUME_PREFIX=
# Image the stack runs, and the tag `sandbox build` produces.
THEONE_IMAGE=theone/sandbox:latest

# ---------------------------------------------------------------------------
# Tailscale sidecar (mode: tailscale)
# ---------------------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys (tskey-auth-...).
# Only needed for the first start: the node state persists in the <prefix>-tailscale
# volume, so the key can be removed afterwards. Prefer a tagged, non-ephemeral key.
TS_AUTHKEY=
# Tailnet DNS name (admin console > DNS > Tailnet name), e.g. tail1234.ts.net. Builds the
# URL the phone pairs with: https://<THEONE_HOSTNAME>.<TS_TAILNET_DOMAIN>. MagicDNS and
# HTTPS certificates must be enabled for the tailnet.
TS_TAILNET_DOMAIN=
# Node name on the tailnet; also shown as the sandbox id in the app.
THEONE_HOSTNAME=theone-sandbox
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:theone
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Host binding (modes: host-tailscale, local)
# ---------------------------------------------------------------------------
# host-tailscale: defaults to the output of `tailscale ip -4` on the host. Must be an IPv4
# address of this host; wildcards (0.0.0.0, ::, [::0], …) are refused.
# local: always 127.0.0.1 (this value is ignored).
THEONE_BIND_ADDR=
# Host ports for the controller and VNC; the container side stays 7700/5901.
THEONE_CONTROLLER_HOST_PORT=7700
THEONE_VNC_HOST_PORT=5901

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------
# Fixed bearer token. Empty = generated on first start and stored in the workspace
# volume; `sandbox pair` shows the pairing link/QR code either way.
THEONE_TOKEN=
# debug | info | warn | error
THEONE_LOG_LEVEL=info
# Permission mode of headless Claude runs started from the phone (any
# `claude --permission-mode` value, e.g. acceptEdits or plan). Unattended runs cannot
# answer permission prompts, so the default lets them use tools freely: the container,
# not Claude's prompts, is the security boundary.
THEONE_CLAUDE_PERMISSION_MODE=bypassPermissions
# Comma-separated browser origins allowed by CORS. The API only accepts the bearer token
# header (never cookies), so "*" grants nothing without the token; list origins, e.g.
# http://localhost:8081, to restrict browser clients further.
THEONE_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Speech-to-text (voice notes from the phone)
# ---------------------------------------------------------------------------
# whisper.cpp (default) transcribes locally inside the sandbox and never calls a paid API.
# auto = whisper.cpp when installed, else the OpenAI-compatible service below when URL and
# key are set. openai-compatible | none force one.
THEONE_STT_ENGINE=whisper.cpp
# Resource profile until one is picked in the desktop app (the choice is then stored):
# off | eco (base model, 2 threads, nice 19, idle I/O) | balanced (base, cpus/4 threads,
# nice 10) | performance (small, cpus/2 threads, nice 0). One transcription runs at a time.
THEONE_STT_PROFILE=eco
# Where the profiles look for ggml-<model>.bin; a missing model falls back to THEONE_WHISPER_MODEL.
THEONE_WHISPER_MODELS_DIR=/opt/whisper/models
# OpenAI-compatible base URL, e.g. https://api.openai.com/v1 or https://api.groq.com/openai/v1.
# Voice notes are sent to that service (only with THEONE_STT_ENGINE=openai-compatible or auto).
THEONE_STT_URL=
THEONE_STT_API_KEY=
# whisper-1 (OpenAI), whisper-large-v3-turbo (Groq) …
THEONE_STT_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Display / VNC
# ---------------------------------------------------------------------------
# VNC password. Empty = generated once and persisted in the <prefix>-home volume.
# VNC authentication only uses the first 8 characters.
THEONE_VNC_PASSWORD=
# Virtual display size (WIDTHxHEIGHT).
THEONE_DISPLAY_GEOMETRY=1600x900

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# Claude Code in the sandbox uses the host's login: this host directory is bind-mounted at
# /home/dev/.claude (read-write: credentials, settings and session history are shared with
# the host). Empty = $HOME/.claude. It must exist (run `claude` on the host and log in once);
# DEV_UID/DEV_GID must match its owner.
THEONE_HOST_CLAUDE_DIR=

# ---------------------------------------------------------------------------
# Resources (sandbox container limits)
# ---------------------------------------------------------------------------
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
SANDBOX_PIDS=4096
TZ=UTC
# Limits of the docker:dind sidecar (--dind); they cap every container started through it.
DIND_CPUS=4
DIND_MEMORY=8g
DIND_PIDS=4096

# ---------------------------------------------------------------------------
# Image build arguments (apply on `sandbox build` / `sandbox up --build`)
# ---------------------------------------------------------------------------
# uid/gid of the dev user; match your host user if you ever export files from volumes.
DEV_UID=1000
DEV_GID=1000
# false = skip JDK 17 + Android SDK (saves about 750 MB).
WITH_ANDROID=true
# false = skip mono (Squirrel.Windows); NSIS, portable and zip targets still work.
WITH_MONO=true
# npm version or dist-tag of @anthropic-ai/claude-code baked into the image.
CLAUDE_CODE_VERSION=latest
# true = build whisper.cpp and download models for local speech-to-text of voice notes.
WITH_WHISPER=true
# Space-separated ggml model names (tiny, base, small, medium, large-v3, *.en …), downloaded
# from huggingface.co/ggerganov/whisper.cpp; bigger is slower and more accurate. The STT
# profiles use base and small; ggml-model.bin links to the first one.
WHISPER_MODELS="base small"
