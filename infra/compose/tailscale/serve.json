{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "5901": {
      "TCPForward": "127.0.0.1:5901"
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:7700"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false
  }
}
