# Tesseract Network control plane. Copy to .env next to compose.yml.

# Public HTTPS URL of Headscale. Clients pass it to tsnet as the login server; the account service returns it as
# DeviceKey.loginServer. Must be https:// (the embedded DERP relay requires TLS) and must not sit under the domain below.
TESSERACT_LOGIN_SERVER=https://net.example.com
# MagicDNS base domain (ADR 0014 default: tesseract.internal).
TESSERACT_NET_DOMAIN=tesseract.internal

# Written by ./bootstrap (headscale apikeys create). Only the account service holds it.
ACCOUNT_HEADSCALE_API_KEY=

# Sign in with Apple: comma-separated accepted `aud` values (the iOS bundle id, plus any Services ID).
ACCOUNT_APPLE_AUDIENCES=
# App Review demo account, seeded (or its password reset) on every start. Password: at least 10 characters.
ACCOUNT_DEMO_EMAIL=
ACCOUNT_DEMO_PASSWORD=

# Optional `tls` profile (docker compose --profile tls up -d): Caddy terminates TLS for both hosts.
HEADSCALE_HOST=net.example.com
ACCOUNT_HOST=account.example.com
ACME_EMAIL=

# Optional overrides.
# HEADSCALE_VERSION=0.29.7
# HEADSCALE_BIND_ADDR=127.0.0.1
# ACCOUNT_BIND_ADDR=127.0.0.1
# ACCOUNT_IMAGE=tesseract/account:latest
# TESSERACT_NET_COMPOSE_PROJECT=tesseract-net
