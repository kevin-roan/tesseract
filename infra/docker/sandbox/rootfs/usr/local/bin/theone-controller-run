#!/usr/bin/env bash
# supervisord program "controller": loads the per-start secrets written by
# theone-entrypoint (VNC password) and runs the controller daemon.
set -euo pipefail

readonly env_file=/run/theone/controller.env

if [[ -r "${env_file}" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "${env_file}"
  set +a
fi

exec /usr/local/bin/theone-controller serve
