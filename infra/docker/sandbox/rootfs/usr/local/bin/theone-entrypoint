#!/usr/bin/env bash
# Runs as root under tini on every container start. Idempotent: prepares the volumes
# and per-start state, then hands over to supervisord (every program runs as dev).
# Any arguments replace supervisord, e.g. `docker run … theone/sandbox bash`.
set -euo pipefail

readonly DEV_USER=dev
readonly DEV_HOME=/home/dev
readonly WORKSPACE="${THEONE_WORKSPACE:-/workspace}"
readonly AGENT_DIR="${WORKSPACE}/.agent"
readonly TEMPLATE_DIR=/etc/theone/agent-templates
readonly VNC_DIR="${DEV_HOME}/.vnc"
readonly RUN_DIR=/run/theone
readonly CONTROLLER_ENV="${RUN_DIR}/controller.env"
readonly SUPERVISOR_RUN_DIR=/run/supervisor

DEV_UID="$(id -u "${DEV_USER}")"
DEV_GID="$(id -g "${DEV_USER}")"
readonly DEV_UID DEV_GID

log() {
  printf '[theone-entrypoint] %s\n' "$*" >&2
}

# Compose passes unset .env entries as empty strings; the controller and Claude Code
# must see them as absent instead.
drop_empty_env() {
  local name
  for name in $(compgen -e); do
    case "${name}" in
      THEONE_* | ANTHROPIC_* | CLAUDE_* | DOCKER_*)
        if [[ -z "${!name}" ]]; then
          unset "${name}"
        fi
        ;;
    esac
  done
}

# ~/.claude and ~/.claude-<account> are host Claude dirs (bind mounts): their ownership
# belongs to the host user.
ensure_owned_by_dev() {
  local dir=$1
  [[ -d "${dir}" ]] || return 0
  if [[ "$(stat -c '%u:%g' "${dir}")" != "${DEV_UID}:${DEV_GID}" ]]; then
    log "fixing ownership of ${dir} for uid ${DEV_UID}"
    find "${dir}" \( -path "${DEV_HOME}/.claude" -o -path "${DEV_HOME}/.claude-*" \) -prune \
      -o -exec chown -h "${DEV_UID}:${DEV_GID}" {} +
  fi
}

# The volumes are writable by dev, so root must never follow a symlink planted in them
# (that would hand dev arbitrary root-owned files when sudo is disabled): symlinked
# directories are replaced, and files are renamed into place from a fresh temporary file.
dev_dir() {
  local mode=$1 dir
  shift
  for dir in "$@"; do
    if [[ -L "${dir}" ]]; then
      rm -f -- "${dir}"
    fi
    install -d -o "${DEV_USER}" -g "${DEV_USER}" -m "${mode}" "${dir}"
  done
}

# Usage: write_dev_file <dest> <mode> < content
write_dev_file() {
  local dest=$1 mode=$2 tmp
  tmp="$(mktemp "${dest}.XXXXXX")"
  cat > "${tmp}"
  chown "${DEV_USER}:${DEV_USER}" "${tmp}"
  chmod "${mode}" "${tmp}"
  mv -fT "${tmp}" "${dest}"
}

prepare_workspace() {
  dev_dir 0755 "${WORKSPACE}" "${WORKSPACE}/projects" "${WORKSPACE}/artifacts" \
    "${AGENT_DIR}" "${AGENT_DIR}/projects" "${AGENT_DIR}/logs" "${AGENT_DIR}/logs/supervisor"
  dev_dir 0700 "${AGENT_DIR}/controller"
}

seed_agent_templates() {
  [[ -d "${TEMPLATE_DIR}" ]] || return 0
  local src rel seeded=0
  while IFS= read -r -d '' src; do
    rel="${src#"${TEMPLATE_DIR}"/}"
    dev_dir 0755 "${AGENT_DIR}/${rel}"
  done < <(find "${TEMPLATE_DIR}" -mindepth 1 -type d -print0)
  while IFS= read -r -d '' src; do
    rel="${src#"${TEMPLATE_DIR}"/}"
    if [[ ! -e "${AGENT_DIR}/${rel}" ]]; then
      install -o "${DEV_USER}" -g "${DEV_USER}" -m 0644 "${src}" "${AGENT_DIR}/${rel}"
      seeded=$((seeded + 1))
    fi
  done < <(find "${TEMPLATE_DIR}" -type f -print0)
  if ((seeded > 0)); then
    log "seeded ${seeded} agent memory file(s) into ${AGENT_DIR}"
  fi
}

generate_password() {
  python3 -c 'import secrets, string; a = string.ascii_letters + string.digits; print("".join(secrets.choice(a) for _ in range(8)))'
}

# The plaintext password is persisted (0600) in the home volume so it survives restarts,
# and handed to the controller through an env file that only its launcher reads, together
# with THEONE_TOKEN and THEONE_STT_API_KEY when compose sets them. main() then removes them
# from the environment supervisord passes to every program.
setup_vnc_password() {
  local password_file="${VNC_DIR}/password" password
  dev_dir 0700 "${VNC_DIR}"
  if [[ -n "${THEONE_VNC_PASSWORD:-}" ]]; then
    password="${THEONE_VNC_PASSWORD}"
  elif [[ -f "${password_file}" && ! -L "${password_file}" && -s "${password_file}" ]]; then
    password="$(< "${password_file}")"
  else
    password="$(generate_password)"
    printf '%s\n' "${password}" | write_dev_file "${password_file}" 0600
    log "generated a VNC password (${password_file})"
  fi
  if ((${#password} > 8)); then
    log "VNC authentication only uses the first 8 characters of the password"
  fi
  if command -v vncpasswd > /dev/null 2>&1; then
    printf '%s\n' "${password}" | vncpasswd -f | write_dev_file "${VNC_DIR}/passwd" 0600
  fi
  # Root-owned so dev cannot swap the file for a symlink; the file itself is dev's (0600).
  install -d -o root -g root -m 0755 "${RUN_DIR}"
  {
    printf 'THEONE_VNC_PASSWORD=%q\n' "${password}"
    if [[ -n "${THEONE_TOKEN:-}" ]]; then
      printf 'THEONE_TOKEN=%q\n' "${THEONE_TOKEN}"
    fi
    if [[ -n "${THEONE_STT_API_KEY:-}" ]]; then
      printf 'THEONE_STT_API_KEY=%q\n' "${THEONE_STT_API_KEY}"
    fi
  } | write_dev_file "${CONTROLLER_ENV}" 0600
}

# /tmp lives in the container layer, so a restarted container still carries the X lock
# of the previous run; nothing can be using it before supervisord starts.
prepare_runtime_dirs() {
  local number="${THEONE_DISPLAY:-:1}"
  number="${number#*:}"
  number="${number%%.*}"
  install -d -m 1777 /tmp/.X11-unix
  rm -f "/tmp/.X${number}-lock" "/tmp/.X11-unix/X${number}"
  install -d -o "${DEV_USER}" -g "${DEV_USER}" -m 0700 "${XDG_RUNTIME_DIR:-/run/user/${DEV_UID}}"
  install -d -o "${DEV_USER}" -g "${DEV_USER}" -m 0700 "${SUPERVISOR_RUN_DIR}"
  # supervisord runs as dev; logs left by an older image whose supervisord ran as root
  # would otherwise stop it from starting. -R changes symlinks themselves, never targets.
  chown -R "${DEV_UID}:${DEV_GID}" "${AGENT_DIR}/logs/supervisor"
}

# Probes run as dev: some tools live in dev-writable paths (the Android SDK), and root must
# never execute a file dev could have replaced.
tool_version() {
  local out
  command -v "$1" > /dev/null 2>&1 || {
    printf 'not installed'
    return 0
  }
  if out="$(runuser -u "${DEV_USER}" -- timeout 20 "$@" 2>&1)" && [[ -n "${out}" ]]; then
    printf '%s' "${out%%$'\n'*}"
  else
    printf 'unavailable'
  fi
}

package_version() {
  dpkg-query -W -f='${Version}' "$1" 2> /dev/null || printf 'not installed'
}

claude_version() {
  local manifest=/usr/local/lib/node_modules/@anthropic-ai/claude-code/package.json
  if [[ -r "${manifest}" ]]; then
    jq -r '.version' "${manifest}"
  else
    tool_version claude --version
  fi
}

list_dir() {
  local dir=$1 entries
  entries="$(find "${dir}" -mindepth 1 -maxdepth 1 -printf '%f\n' 2> /dev/null | sort | paste -sd ',' - | sed 's/,/, /g')"
  printf '%s' "${entries:-none}"
}

memory_limit() {
  local limit
  limit="$(cat /sys/fs/cgroup/memory.max 2> /dev/null || printf 'max')"
  if [[ "${limit}" =~ ^[0-9]+$ ]]; then
    printf '%s GiB' "$((limit / 1024 / 1024 / 1024))"
  else
    awk '/MemTotal/ {printf "%d GiB (no cgroup limit)", $2 / 1024 / 1024}' /proc/meminfo
  fi
}

write_environment_md() {
  local tmp android_home="${ANDROID_HOME:-/opt/android-sdk}" java_home="${JAVA_HOME:-/opt/java/openjdk}"
  tmp="$(mktemp "${AGENT_DIR}/.ENVIRONMENT.md.XXXXXX")"
  {
    printf '# Environment\n\n'
    printf 'Generated by theone-entrypoint at %s. Regenerated on every sandbox start: do not edit.\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'Durable notes belong in GLOBAL_CONTEXT.md; live processes are listed in RUNTIME.md.\n\n'

    printf '## Sandbox\n\n| Key | Value |\n|---|---|\n'
    printf '| Sandbox id | %s |\n' "${THEONE_SANDBOX_ID:-${HOSTNAME}}"
    printf '| Image version | %s |\n' "${THEONE_IMAGE_VERSION:-unknown}"
    printf '| OS | %s |\n' "$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '"')"
    printf '| Kernel | %s |\n' "$(uname -r)"
    printf '| CPUs | %s |\n' "$(nproc)"
    printf '| Memory limit | %s |\n' "$(memory_limit)"
    printf '| Workspace | %s (%s free) |\n' "${WORKSPACE}" "$(df -Ph "${WORKSPACE}" | awk 'NR == 2 {print $4}')"
    printf '| User | %s (uid %s), passwordless sudo: %s |\n' "${DEV_USER}" "${DEV_UID}" "$([[ -f /etc/sudoers.d/dev ]] && printf yes || printf no)"
    printf '\n'

    printf '## Access\n\n| Key | Value |\n|---|---|\n'
    printf '| Controller | http://127.0.0.1:%s (public: %s) |\n' "${THEONE_PORT:-7700}" "${THEONE_PUBLIC_URL:-not configured}"
    printf '| X display | %s (%s), window manager openbox |\n' "${THEONE_DISPLAY:-:1}" "${THEONE_DISPLAY_GEOMETRY:-1600x900}"
    printf '| VNC | port %s, VncAuth (password held by the controller; never print it) |\n' "${THEONE_VNC_PORT:-5901}"
    printf '| Docker | %s |\n' "${DOCKER_HOST:-not available (stack started without --dind)}"
    printf '\n'

    printf '## Tools\n\n| Tool | Version |\n|---|---|\n'
    printf '| node | %s |\n' "$(tool_version node --version)"
    printf '| npm | %s |\n' "$(tool_version npm --version)"
    printf '| corepack (pnpm, yarn) | %s |\n' "$(tool_version corepack --version)"
    printf '| bun | %s |\n' "$(tool_version bun --version)"
    printf '| git | %s |\n' "$(tool_version git --version)"
    printf '| python3 | %s |\n' "$(tool_version python3 --version)"
    printf '| pipx | %s |\n' "$(tool_version pipx --version)"
    printf '| claude | %s |\n' "$(claude_version)"
    printf '| java | %s |\n' "$(tool_version java -version)"
    printf '| adb | %s |\n' "$(tool_version adb version)"
    printf '| wine | %s |\n' "$(tool_version wine --version)"
    printf '| mono | %s |\n' "$(tool_version mono --version)"
    printf '| chromium | %s |\n' "$(package_version chromium)"
    printf '| tigervnc | %s |\n' "$(package_version tigervnc-standalone-server)"
    printf '| docker (client) | %s |\n' "$(tool_version docker --version)"
    printf '| docker compose | %s |\n' "$(tool_version docker compose version)"
    printf '\n'

    printf '## Paths\n\n'
    printf -- '- Projects: %s/projects/<projectId>\n' "${WORKSPACE}"
    printf -- '- Artifacts: %s/artifacts/<project>-<platform>-<profile>-<version>.<ext>\n' "${WORKSPACE}"
    printf -- '- JAVA_HOME: %s\n' "${java_home}"
    printf -- '- ANDROID_HOME: %s (platforms: %s; build-tools: %s)\n' "${android_home}" "$(list_dir "${android_home}/platforms")" "$(list_dir "${android_home}/build-tools")"
    if [[ -d "${android_home}" && ! -w "${android_home}" ]]; then
      printf -- '- The Android SDK is the host'\''s, mounted read-only (ndk: %s; cmake: %s): never sdkmanager --install, ask the user to install a missing package on the host.\n' "$(list_dir "${android_home}/ndk")" "$(list_dir "${android_home}/cmake")"
    fi
    if [[ -n "${GRADLE_RO_DEP_CACHE:-}" ]]; then
      printf -- '- GRADLE_RO_DEP_CACHE: %s (the host'\''s Gradle dependency cache, read-only)\n' "${GRADLE_RO_DEP_CACHE}"
    fi
    printf -- '- WINEPREFIX: %s (WINEARCH=%s)\n' "${WINEPREFIX:-${DEV_HOME}/.wine}" "${WINEARCH:-win64}"
    printf -- '- Supervisor logs: %s/logs/supervisor/\n' "${AGENT_DIR}"
    printf '\n'

    printf '## Notes\n\n'
    printf -- '- GUI programs must target DISPLAY=%s; Chromium and Electron need --no-sandbox in this container.\n' "${THEONE_DISPLAY:-:1}"
    printf -- '- AppImages run without FUSE because APPIMAGE_EXTRACT_AND_RUN=1 is set.\n'
    printf -- '- Windows builds run through wine: NSIS, portable and zip targets; Squirrel.Windows only when mono is installed.\n'
    printf -- '- No Android emulator (no KVM) and no macOS builds.\n'
    printf -- '- Helpers: theone-doctor (health), theone-screenshot (display capture), theone-controller emit (status to the phone).\n'
    printf -- '- Local API: only through theone-controller api METHOD PATH [JSON|-]; never touch %s/controller/.\n' "${AGENT_DIR}"
  } > "${tmp}"
  # Called from an `||` list, where errexit is off: check each step and never leak the file.
  if ! { chown "${DEV_USER}:${DEV_USER}" "${tmp}" && chmod 0644 "${tmp}" && mv -fT "${tmp}" "${AGENT_DIR}/ENVIRONMENT.md"; }; then
    rm -f -- "${tmp}"
    return 1
  fi
}

main() {
  drop_empty_env
  ensure_owned_by_dev "${WORKSPACE}"
  ensure_owned_by_dev "${DEV_HOME}"
  prepare_workspace
  seed_agent_templates
  setup_vnc_password
  prepare_runtime_dirs
  write_environment_md || log "could not write ${AGENT_DIR}/ENVIRONMENT.md"

  if (($# > 0)); then
    exec "$@"
  fi
  unset THEONE_TOKEN THEONE_VNC_PASSWORD THEONE_STT_API_KEY
  exec /usr/bin/supervisord -n -c /etc/supervisor/supervisord.conf
}

main "$@"
