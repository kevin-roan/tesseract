[Desktop Entry]
Type=Application
Name=Tesseract
GenericName=Sandbox Companion
Comment=Monitor and control the Tesseract sandbox, pair phones and watch the host
Exec=tesseract-desktop %U
Icon=dev.tesseract.Desktop
Terminal=false
Categories=Development;Monitor;GTK;
Keywords=sandbox;docker;claude;pair;
StartupNotify=true
StartupWMClass=dev.tesseract.Desktop
DBusActivatable=false
X-GNOME-UsesNotifications=true
