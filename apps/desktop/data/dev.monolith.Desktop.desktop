[Desktop Entry]
Type=Application
Name=Monolith
GenericName=Sandbox Companion
Comment=Monitor and control the Monolith sandbox, pair phones and watch the host
Exec=monolith-desktop %U
Icon=dev.monolith.Desktop
Terminal=false
Categories=Development;Monitor;GTK;
Keywords=sandbox;docker;claude;pair;
StartupNotify=true
StartupWMClass=dev.monolith.Desktop
DBusActivatable=false
X-GNOME-UsesNotifications=true
