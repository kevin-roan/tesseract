{
  "expo": {
    "name": "Tesseract",
    "slug": "tesseract",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/58203c4d-5325-4b45-881e-9d2755d88806"
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tesseract",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kevinroan.tesseract",
      "appleTeamId": "K26L46GQQ8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.kevinroan.tesseract",
          "group.com.kevinroan.tesseract"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "package": "com.kevinroan.tesseract"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "ios": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#000000"
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone to record voice messages for Claude."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan pairing codes and take photos for Claude.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos from your library to messages for Claude.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan pairing codes and take photos for Claude.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone to record voice messages for Claude."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#000000"
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "syncboard",
          "project": "tesseract"
        }
      ],
      "./plugins/with-island",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.kevinroan.tesseract.share",
                  "targetName": "share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.kevinroan.tesseract"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.kevinroan.tesseract.island",
                  "targetName": "island",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.kevinroan.tesseract"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "58203c4d-5325-4b45-881e-9d2755d88806"
      }
    },
    "owner": "streaxfit"
  }
}
