{
  "name": "@theone/controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "theone-controller": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts serve",
    "start": "bun src/index.ts serve",
    "build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/theone-controller",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p tests/ui/tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@theone/protocol": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@theone/client": "workspace:*",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5"
  }
}
