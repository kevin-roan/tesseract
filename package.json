{
  "name": "theone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun run --cwd apps/mobile start",
    "controller:dev": "bun run --cwd apps/controller dev",
    "controller:build": "bun run --cwd apps/controller build",
    "host": "bun apps/controller/src/index.ts host",
    "electron": "bun run --cwd apps/electron dev",
    "electron:build": "bun run --cwd apps/electron build",
    "electron:e2e": "bun run --cwd apps/electron e2e",
    "electron:dist": "bun run --cwd apps/electron dist",
    "electron:smoke": "bun run --cwd apps/electron smoke",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "sandbox": "infra/scripts/sandbox",
    "e2e": "infra/e2e/run",
    "test:infra": "infra/tests/run"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "dependencies": {
    "expo-updates": "~56.0.28"
  }
}
